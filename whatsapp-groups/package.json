{
  "name": "whatsapp-groups-motion",
  "version": "1.0.0",
  "private": true,
  "description": "סצנת מושן גרפיקס של קבוצות WhatsApp בעברית (16:9) — מקור עריך ורינדור ל-MP4",
  "type": "module",
  "scripts": {
    "render": "node render.mjs",
    "render:30": "node render.mjs --fps 30 --out output/whatsapp-groups-30fps.mp4",
    "stills": "node render.mjs --stills 0.5,1.5,3,4,5.5,8,10,11.9",
    "preview": "npx --yes http-server -p 8080 -c-1 .",
    "fonts": "node tools/build-fonts.mjs"
  },
  "dependencies": {
    "playwright-core": "1.56.1"
  }
}
